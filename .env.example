# Copy this file to .env and fill in real values.
# .env should be added to .gitignore and NEVER committed.

EMAIL_SENDER=sender@gmail.com
SMTP_USERNAME=
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=receiver@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_TO=+15551234567

# Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TO=

# Path to the directory containing the trained model artifacts:
#   binary_model.joblib, binary_scaler.joblib,
#   multiclass_model.joblib, multiclass_scaler.joblib,
#   multiclass_label_encoder.joblib, feature_columns.joblib
MODELS_DIR=./models

# Optional path for alert settings saved from the frontend alerts page.
ALERT_CONFIG_PATH=./alert_channels.local.json

# Seconds of inactivity before a flow is considered finished and classified.
# CICFlowMeter default is 120s. Lower values (e.g. 15-30) make the live
# dashboard feel more responsive for demos, at the cost of matching the
# exact feature distribution the model was trained on (which used 120s).
FLOW_ACTIVITY_TIMEOUT=10

# How often (seconds) the background sweeper checks for expired flows.
FLOW_SWEEP_INTERVAL=5
